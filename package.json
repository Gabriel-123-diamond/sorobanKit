{
  "name": "stellar-defi-backend",
  "version": "1.0.0",
  "description": "Backend API for Stellar DeFi application",
  "main": "src/index.js",
  "scripts": {
    "start": "npm --prefix stellar-payment-platform start",
    "lint": "eslint .",
    "prepare": "husky",
    "load:test": "artillery run artillery.yml",
    "generate:bindings": "bash scripts/generate-bindings.sh",
    "test:unit": "npm --prefix stellar-payment-platform test -- --testPathPattern=tests/unit --passWithNoTests",
    "test:integration": "bash tests/integration/run.sh",
    "contract:build": "node scripts/deploy.js build",
    "contract:deploy": "node scripts/deploy.js deploy",
    "contract:upgrade": "node scripts/deploy.js upgrade",
    "deploy:verify-hash": "node scripts/deploy.js verify-hash"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/index.js"],
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  }
}