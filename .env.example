# Server
PORT=3000
NODE_ENV=development

# JWT
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Rate limiting
# Requests allowed per window for anonymous (unauthenticated) callers
RATE_LIMIT_ANONYMOUS=60
# Requests allowed per window for authenticated callers (valid X-Api-Key)
RATE_LIMIT_AUTHENTICATED=600
# Window length in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# OpenTelemetry tracing
# OTLP HTTP endpoint of a collector (e.g. http://localhost:4318/v1/traces).
# Tracing is disabled when this is unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name reported on emitted spans
OTEL_SERVICE_NAME=stellar-api
