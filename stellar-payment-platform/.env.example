# ---------------------------------------------------------------------------
# Stellar Payment Platform — environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Optional pool tuning: append &connection_limit=10&pool_timeout=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellar_tags?schema=public"

# Port the API server listens on (defaults to 5000).
# PORT=5000

# Horizon listener network: "testnet" (default) or "public".
# HORIZON_NETWORK=testnet

# Base URL for the Horizon server the health check probes and the payment
# router queries.  Defaults to the public Stellar testnet if unset.
# Set this to your staging or production Horizon endpoint in non-local envs.
# HORIZON_BASE=https://horizon-testnet.stellar.org

# Redis connection string used by the idempotency middleware, rate limiter,
# federation cache, and the BullMQ webhook worker.
# Optional only when none of those Redis-backed features are enabled; the
# webhook worker otherwise defaults to redis://127.0.0.1:6379.
# Start a local Redis with the Docker Compose profile:
#   docker compose --profile redis up -d
REDIS_URL="redis://localhost:6379"

# --- Logging (rotating files) -------------------------------------------------
# Directory the rotating log files are written to.
# Defaults to `stellar-payment-platform/logs`.
# LOG_DIR="./logs"

# Minimum level to record: error | warn | info | http | verbose | debug | silly.
# Defaults to "info" in production and "debug" everywhere else.
# LOG_LEVEL=info

# Rotate the active log file once it grows past this size.
# LOG_MAX_SIZE=20m

# How much history to keep. Accepts a count ("30") or an age ("14d").
# LOG_MAX_FILES=14d

# Port for Prometheus metrics (if running on separate port)
# Leave unset to serve /metrics on the main app port
# METRICS_PORT=9090
# --- Error reporting (Sentry) --------------------------------------------------
# When set, unhandled errors (including 5xx Express errors, uncaught exceptions
# and unhandled promise rejections) are reported to this Sentry project.
# Left unset, Sentry is never initialized (e.g. local dev, tests).
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# --- Startup migration check --------------------------------------------------
# Behaviour when `prisma migrate status` finds the database out of sync:
#   "strict" -> log an error and exit (non-zero) before the server binds a port
#   "warn"   -> log a warning and keep booting (default)
#   "off"    -> skip the startup check entirely
# MIGRATION_POLICY=warn

# --- Admin API Key -------------------------------------------------------------
# Key used to authenticate with protected admin endpoints (e.g., blocking addresses)
ADMIN_API_KEY="your-secure-admin-api-key-here"

# --- Webhook worker concurrency -----------------------------------------------
# Maximum number of simultaneous outbound webhook deliveries processed by the
# BullMQ worker.  Increase this on high-throughput deployments; lower it if the
# platform's outbound IP is being rate-limited by merchant endpoints.
# WEBHOOK_CONCURRENCY=10

# Maximum age in days for webhook dead-letter queue entries (defaults to 30).
# WEBHOOK_DLQ_MAX_AGE_DAYS=30

# --- Webhook retry backoff (exponential with jitter) --------------------------
# Failed webhook deliveries are retried with exponential backoff:
#   delay = min(base * factor^(attempt - 1), max)  ± jitter
# Base delay in milliseconds for the first retry (defaults to 30000 = 30s).
# WEBHOOK_RETRY_BASE_MS=30000

# Upper bound in milliseconds for any retry delay (defaults to 3600000 = 1h).
# WEBHOOK_RETRY_MAX_MS=3600000

# Multiplier applied to the delay on each successive attempt (defaults to 2).
# WEBHOOK_RETRY_FACTOR=2

# --- Rate limiting (tiered by authentication) ---------------------------------
# Requests per minute allowed for authenticated clients presenting a valid
# X-Api-Key header (defaults to 1000).
# RATE_LIMIT_AUTHENTICATED=1000

# Requests per minute allowed for anonymous clients (no or invalid API key).
# Defaults to 100.
# RATE_LIMIT_ANONYMOUS=100

# --- Horizon fetch timeout (multisigner verifier) -----------------------------

# Maximum milliseconds to wait for a single Horizon account fetch before
# cancelling the request.  Applies on top of the circuit-breaker timeout so
# a single slow Horizon response cannot hold an event-loop slot indefinitely.
# Defaults to 5000 (5 seconds).
# HORIZON_FETCH_TIMEOUT_MS=5000

# --- Horizon signer cache TTL (ownership service) -----------------------------
# Milliseconds to cache Horizon account signer lists in Redis / memory keyed by
# Stellar address to reduce Horizon round-trips on repeated ownership checks.
# Defaults to 60000 (60 seconds).
# SIGNER_CACHE_TTL_MS=60000

# --- CORS ------------------------------------------------------------------
# Extra origins allowed to call the API, beyond the built-in localhost/vercel
# defaults. Accepts a single origin or a comma-separated list.
# CORS_ALLOWED_ORIGINS="https://example.com,https://staging.example.com"
# VITE_API_BASE="https://api.yourdomain.com"

# --- JWT (RS256) --------------------------------------------------------------
# RSA key pair for signing and verifying JWTs.
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the file contents below, replacing literal newlines with \n,
# or keep multi-line PEM values inside double quotes.
#
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# Token lifetime (default: 1h). Accepts ms/zeit-ms format or seconds.
# JWT_EXPIRY="1h"
# Admin export row ceiling; positive integer, at most 2147483647.
ADMIN_EXPORT_MAX_ROWS=1000000
